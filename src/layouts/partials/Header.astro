---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button } = config;
let { pathname } = Astro.url;
// normalise trailing slash for active-state matching
if (pathname.length > 1 && pathname.endsWith("/")) {
  pathname = pathname.slice(0, -1);
}

const isActive = (url: string) => url !== "#" && pathname === url;
const childActive = (children?: ChildNavigationLink[]) =>
  children?.some((c) => isActive(c.url)) ?? false;
---

<header>
  <div class="wrap nav">
    <Logo />
    <button
      class="navtoggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="primary-menu"
    >
      <span></span><span></span><span></span>
    </button>
    <ul class="menu" id="primary-menu">
      {
        main.map((item) =>
          item.hasChildren ? (
            <li class="has">
              <button
                class={`mtrig${childActive(item.children) ? " on" : ""}`}
                type="button"
              >
                {item.name}
              </button>
              <div class="drop">
                {item.children?.map((child) => (
                  <a
                    href={child.url}
                    class={isActive(child.url) ? "on" : ""}
                  >
                    {child.name}
                  </a>
                ))}
              </div>
            </li>
          ) : (
            <li>
              <a href={item.url} class={isActive(item.url) ? "on" : ""}>
                {item.name}
              </a>
            </li>
          ),
        )
      }
    </ul>
    {
      navigation_button.enable && (
        <a class="btn pri sm" href={navigation_button.link}>
          {navigation_button.label}
        </a>
      )
    }
  </div>
</header>

<script is:inline>
  // Mobile nav toggle. Delegated + guarded so it survives view transitions.
  (function () {
    if (window.__ghlNavInit) return;
    window.__ghlNavInit = true;

    var close = function () {
      document.querySelectorAll(".nav.open").forEach(function (nav) {
        nav.classList.remove("open");
        var t = nav.querySelector(".navtoggle");
        if (t) t.setAttribute("aria-expanded", "false");
      });
    };

    document.addEventListener("click", function (e) {
      var toggle = e.target.closest(".navtoggle");
      if (toggle) {
        var nav = toggle.closest(".nav");
        if (!nav) return;
        var open = nav.classList.toggle("open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        return;
      }
      // close after choosing a destination
      if (e.target.closest(".nav .menu a")) close();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });

    // never leave the panel open across a navigation or a resize to desktop
    document.addEventListener("astro:after-swap", close);
    window.addEventListener("resize", function () {
      if (window.innerWidth > 680) close();
    });
  })();
</script>
