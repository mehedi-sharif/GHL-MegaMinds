---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
// Delivered as a literal <style> tag in the document head (see below). Astro's
// dev server injects main.css through a runtime JS module, which can serve a
// stale copy; critical layout CSS must arrive with the HTML instead.
import sectionsCss from "@/styles/sections.css?raw";
import responsiveCss from "@/styles/responsive.css?raw";
import {
  SITE,
  absoluteUrl,
  breadcrumbSchema,
  canonicalUrl,
  jsonLdGraph,
  organizationSchema,
  websiteSchema,
} from "@/lib/seo";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";
import SearchModal from "./helpers/SearchModal";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  /** og:type — "website" for pages, "article" for posts, "profile" for authors. */
  type?: "website" | "article" | "profile";
  /** Extra schema.org nodes merged into the page's JSON-LD @graph. */
  schema?: unknown[];
  /** Skip the automatic BreadcrumbList (e.g. the home page). */
  noBreadcrumb?: boolean;
  /** Article metadata, used when type === "article". */
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  articleAuthors?: string[];
  articleTags?: string[];
}

// destructure frontmatter
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  type = "website",
  schema = [],
  noBreadcrumb = false,
  publishedTime,
  modifiedTime,
  articleAuthors = [],
  articleTags = [],
} = Astro.props;

/* ---------- resolved SEO values ---------- */

const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
);
const pageDescription = plainify(
  description ? description : config.metadata.meta_description,
);
const pageImage = absoluteUrl(image ? image : config.metadata.meta_image);
const canonicalHref = canonical
  ? canonical
  : canonicalUrl(Astro.url.pathname);

// Explicit crawl directives. max-image-preview/max-snippet let Google and the
// AI answer engines quote the page properly instead of truncating it.
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const toIso = (d: string | Date | undefined) =>
  d ? new Date(d).toISOString() : undefined;

// Sitewide identity graph + per-page breadcrumb + anything the page passes in.
const graphNodes: unknown[] = [
  organizationSchema(),
  websiteSchema(),
  ...(noindex || noBreadcrumb
    ? []
    : [breadcrumbSchema(Astro.url.pathname, title)]),
  ...schema,
];
const jsonLd = jsonLdGraph(graphNodes);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="apple-touch-icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url: always self-referencing so duplicates collapse -->
    <link rel="canonical" href={canonicalHref} />

    <!-- crawl directives -->
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />
    {
      articleTags.length > 0 && (
        <meta name="keywords" content={articleTags.join(", ")} />
      )
    }

    <ClientRouter />

    <!-- author from config.json -->
    <meta
      name="author"
      content={
        articleAuthors.length
          ? articleAuthors.join(", ")
          : config.metadata.meta_author
      }
    />

    <!-- open graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:secure_url" content={pageImage} />
    <meta property="og:image:width" content={String(SITE.imageWidth)} />
    <meta property="og:image:height" content={String(SITE.imageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- article metadata -->
    {
      type === "article" && (
        <>
          {toIso(publishedTime) && (
            <meta
              property="article:published_time"
              content={toIso(publishedTime)}
            />
          )}
          {toIso(modifiedTime) && (
            <meta
              property="article:modified_time"
              content={toIso(modifiedTime)}
            />
          )}
          {articleAuthors.map((a) => (
            <meta property="article:author" content={a} />
          ))}
          {articleTags.map((t) => (
            <meta property="article:tag" content={t} />
          ))}
        </>
      )
    }

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Blog`}
      href={`${SITE.url}/rss.xml`}
    />

    <!-- structured data -->
    <script type="application/ld+json" set:html={jsonLd} is:inline />

    {/* critical layout CSS, inlined so it cannot be served stale */}
    <style set:html={sectionsCss}></style>
    <style set:html={responsiveCss}></style>
  </head>
  <body class="flex flex-col min-h-screen">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <Announcement client:only="react" />
    <Header />
    <SearchModal client:only="react" />
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
  </body>
</html>
