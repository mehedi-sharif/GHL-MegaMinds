---
import Base from "@/layouts/Base.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import { getSinglePage } from "@/lib/contentParser.astro";
import { isByAuthor, postAuthors } from "@/lib/utils/authors";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { slugify } from "@/lib/utils/textConverter";
import { ORG_ID, absoluteUrl, canonicalUrl } from "@/lib/seo";
import { render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const authors = await getSinglePage("authors");

  return authors.map((author) => ({
    params: { single: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const { title, social, meta_title, description, image, role } = author.data;
const { Content } = await render(author);

const posts = sortByDate(await getSinglePage("blog")).filter((post) =>
  isByAuthor(post, title),
);

const monthYear = (d: Date | undefined) =>
  d
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        year: "numeric",
      }).format(new Date(d))
    : "";

// co-authors: everyone else who appears on this author's posts
const coAuthors = [
  ...new Set(
    posts
      .flatMap((p) => postAuthors(p))
      .filter((n) => slugify(n) !== slugify(title)),
  ),
];

const authorUrl = canonicalUrl(`/authors/${author.id}`);
const personLinks = (social || [])
  .map((s: any) => s?.link)
  .filter((l: string) => /^https?:\/\//i.test(l || ""));

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${authorUrl}#webpage`,
    url: authorUrl,
    name: meta_title || title,
    description,
    mainEntity: { "@id": `${authorUrl}#person` },
  },
  {
    "@type": "Person",
    "@id": `${authorUrl}#person`,
    name: title,
    url: authorUrl,
    ...(role ? { jobTitle: role } : {}),
    ...(description ? { description } : {}),
    ...(image ? { image: absoluteUrl(image) } : {}),
    worksFor: { "@id": ORG_ID },
    ...(personLinks.length ? { sameAs: personLinks } : {}),
  },
  ...(posts.length
    ? [
        {
          "@type": "ItemList",
          "@id": `${authorUrl}#posts`,
          name: `Posts by ${title}`,
          numberOfItems: posts.length,
          itemListElement: posts.map((p, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: canonicalUrl(`/blog/${p.id}`),
            name: p.data.title,
          })),
        },
      ]
    : []),
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  type="profile"
  schema={schema}
>
  <section class="hero first">
    <div class="wrap">
      <div class="authorhead">
        {
          image && (
            <div class="authorph">
              <img src={image} alt={title} width="240" height="240" />
            </div>
          )
        }
        <div>
          <div class="eyebrow">
            <span class="label">Author</span><span class="plus">++++</span>
          </div>
          <h1>{title}</h1>
          {role && <p class="authorrole">{role}</p>}
          <div class="authorbio"><Content /></div>
          {
            social && social.length > 0 && (
              <ul class="socials authorsocials">
                {social.map(
                  (item?: { name?: string; icon?: string; link?: string }) =>
                    item?.icon &&
                    item?.link && (
                      <li>
                        <a
                          aria-label={item.name}
                          href={item.link}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                        >
                          <span class="sr-only">{item.name}</span>
                          <DynamicIcon icon={item.icon} />
                        </a>
                      </li>
                    ),
                )}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sechead">
        <span class="label">Writing</span>
        <h2>
          {
            posts.length === 0
              ? "No posts yet."
              : posts.length === 1
                ? "One post."
                : `${posts.length} posts.`
          }
        </h2>
      </div>

      {
        posts.length > 0 ? (
          posts.map((post) => (
            <a class="post" href={`/blog/${post.id}`}>
              <div
                class="meta"
                set:html={`${monthYear(post.data.date)}<br>${post.data.categories?.[0] ?? ""}`}
              />
              <div>
                <h4>{post.data.title}</h4>
                <p>{post.data.description}</p>
                {postAuthors(post).length > 1 && (
                  <p class="withline">
                    With{" "}
                    {postAuthors(post)
                      .filter((n) => slugify(n) !== slugify(title))
                      .join(", ")}
                  </p>
                )}
              </div>
            </a>
          ))
        ) : (
          <p class="muted">
            Nothing published under this name yet. Read{" "}
            <a href="/blog" class="ulink">
              everything on the blog
            </a>{" "}
            instead.
          </p>
        )
      }
    </div>
  </section>

  {
    coAuthors.length > 0 && (
      <section>
        <div class="wrap">
          <div class="sechead">
            <span class="label">Also writes with</span>
            <h2>The rest of the team.</h2>
          </div>
          <div class="btns" style="margin-top:0">
            {coAuthors.map((name) => (
              <a class="btn" href={`/authors/${slugify(name)}`}>
                {name} &rarr;
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
