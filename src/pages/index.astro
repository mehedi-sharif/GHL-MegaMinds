---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { ORG_ID, SITE } from "@/lib/seo";
import { render } from "astro:content";

const homepage = await getListPage("homepage", "-index");
const { title, meta_title, description, image } = homepage.data;
const { Content } = await render(homepage);

// What the business actually sells, in a form answer engines can quote.
const schema = [
  {
    "@type": "ProfessionalService",
    "@id": `${SITE.url}/#service`,
    name: "GoHighLevel setup, rescue and management",
    url: `${SITE.url}/`,
    provider: { "@id": ORG_ID },
    parentOrganization: { "@id": ORG_ID },
    areaServed: "Worldwide",
    availableLanguage: ["English"],
    serviceType: "GoHighLevel implementation and management",
    description:
      "Done-for-you GoHighLevel work: account setup and builds, fixing broken accounts, SaaS Mode for resellers, white label client onboarding, and ongoing monthly care.",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "GHL Megaminds services",
      itemListElement: [
        {
          "@type": "OfferCatalog",
          name: "For business owners",
          url: `${SITE.url}/business-owners`,
          itemListElement: [
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "GoHighLevel account build" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Broken account rescue and audit" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Monthly maintenance and care" } },
          ],
        },
        {
          "@type": "OfferCatalog",
          name: "For resellers",
          url: `${SITE.url}/resellers`,
          itemListElement: [
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "SaaS Mode setup from scratch" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Fixing an existing SaaS account" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "White label client onboarding" } },
          ],
        },
      ],
    },
  },
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  schema={schema}
  noBreadcrumb
>
  <Content />
</Base>
