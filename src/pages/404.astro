---
import Page from '../layouts/Page.astro';
---
<Page
  title="Page not found"
  meta_title="Page not found | GHL Megaminds"
  description="That page does not exist. Head back to the home page or book a free call."
>
  <section class="hero first">
    <div class="wrap">
      <div class="eyebrow"><span class="label">[ 404 ]</span><span class="plus">++++</span></div>
      <h1>Page not<br /><span class="grad">found.</span></h1>
      <p class="lede">The page you are looking for might have been removed, had its name changed, or never existed.</p>
      <div class="btns">
        <a class="btn pri" href="/">Back to home &rarr;</a>
        <a class="btn" href="/contact">Contact us &rarr;</a>
      </div>
    </div>
  </section>
</Page>
