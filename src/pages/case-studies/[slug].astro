---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { ORG_ID, SITE, absoluteUrl, canonicalUrl } from "@/lib/seo";

export const prerender = true;

export async function getStaticPaths() {
  const buildDrafts = process.argv.includes("--buildDrafts");
  const studies = (await getCollection("case-studies"))
    .filter((s) => buildDrafts || !s.data.draft)
    .sort((a, b) => a.data.order - b.data.order);

  return studies.map((study, i) => ({
    params: { slug: study.id },
    props: {
      study,
      // wrap around so there is always a next one to read
      next: studies[(i + 1) % studies.length],
    },
  }));
}

const { study, next } = Astro.props;
const { title, meta_title, description, image, num, kind, results } =
  study.data;
const { Content } = await render(study);

const studyUrl = canonicalUrl(`/case-studies/${study.id}`);
const schema = [
  {
    "@type": "Article",
    "@id": `${studyUrl}#article`,
    headline: title,
    name: title,
    description,
    url: studyUrl,
    mainEntityOfPage: { "@type": "WebPage", "@id": studyUrl },
    author: { "@id": ORG_ID },
    publisher: { "@id": ORG_ID },
    image: absoluteUrl(image || SITE.image),
    inLanguage: SITE.lang,
    articleSection: kind,
    about: { "@id": ORG_ID },
    ...(results?.length
      ? {
          // headline outcomes, so an answer engine can quote the numbers
          mentions: results.map((r) => ({
            "@type": "Thing",
            name: `${r.value} — ${r.label}`,
          })),
        }
      : {}),
  },
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  type="article"
  schema={schema}
>
  <section class="hero first">
    <div class="wrap">
      <div class="eyebrow">
        <span class="label">{num}</span><span class="plus">++++</span><span
          class="label">{kind}</span
        >
      </div>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}

      {
        results.length > 0 && (
          <div class="csresults">
            {results.map((r) => (
              <div class="csresult">
                <div class="big">{r.value}</div>
                <p>{r.label}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Content />

  <section>
    <div class="wrap">
      <div class="csnext">
        <div>
          <span class="label">Read next</span>
          <h3><a href={`/case-studies/${next.id}`}>{next.data.title}</a></h3>
          <p>{next.data.summary}</p>
        </div>
        <div class="btns">
          <a class="btn" href="/case-studies">All case studies &rarr;</a>
          <a class="btn pri" href="/contact">Book a Free Call &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Base>
