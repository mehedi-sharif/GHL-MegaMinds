---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { ORG_ID, SITE, canonicalUrl } from "@/lib/seo";
import { render } from "astro:content";

export const prerender = true;

// get static paths for all pages
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "pages";

  const pages = await getSinglePage(COLLECTION_FOLDER);

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);

const pageUrl = canonicalUrl(`/${page.id}`);

/**
 * Pull the pricing cards straight out of the page body so the structured data
 * can never drift from what a visitor actually reads. Each card looks like:
 *   <div class="pname">Launch</div> ... <div class="amt">$1,720</div>
 *   <div class="per">one time, all in</div>
 */
function parseOffers(body: string) {
  const cards = [
    ...body.matchAll(
      /<div class="pname">([^<]+)<\/div>[\s\S]*?<div class="amt">\$?([\d,]+)<\/div><div class="per">([^<]*)<\/div>/g,
    ),
  ];

  return cards.map(([, name, amount, per]) => {
    const price = Number(amount.replace(/,/g, ""));
    const recurring = /month/i.test(per);
    return {
      "@type": "Offer",
      name: name.trim(),
      price,
      priceCurrency: "USD",
      url: `${pageUrl}#pricing`,
      availability: "https://schema.org/InStock",
      category: recurring ? "Subscription" : "One-time purchase",
      ...(recurring
        ? {
            priceSpecification: {
              "@type": "UnitPriceSpecification",
              price,
              priceCurrency: "USD",
              billingDuration: 1,
              billingIncrement: 1,
              unitCode: "MON",
            },
          }
        : {}),
    };
  });
}

const SERVICE_PAGES: Record<string, { name: string; serviceType: string }> = {
  "business-owners": {
    name: "GoHighLevel setup and monthly care for business owners",
    serviceType: "GoHighLevel implementation and maintenance",
  },
  resellers: {
    name: "GoHighLevel SaaS Mode setup and white label onboarding for resellers",
    serviceType: "SaaS Mode setup and white label client onboarding",
  },
};

const serviceInfo = SERVICE_PAGES[page.id];
const offers = serviceInfo ? parseOffers(page.body ?? "") : [];

const schema = serviceInfo
  ? [
      {
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        name: serviceInfo.name,
        serviceType: serviceInfo.serviceType,
        description,
        url: pageUrl,
        provider: { "@id": ORG_ID },
        areaServed: "Worldwide",
        availableLanguage: ["English"],
        ...(offers.length ? { offers } : {}),
      },
    ]
  : [
      {
        "@type": "WebPage",
        "@id": `${pageUrl}#webpage`,
        url: pageUrl,
        name: meta_title || title,
        description,
        inLanguage: SITE.lang,
        isPartOf: { "@id": `${SITE.url}/#website` },
        publisher: { "@id": ORG_ID },
      },
    ];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  schema={schema}
>
  <Content />
</Base>
