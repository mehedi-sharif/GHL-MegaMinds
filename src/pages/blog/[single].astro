---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { postAuthors } from "@/lib/utils/authors";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { slugify } from "@/lib/utils/textConverter";
import { ORG_ID, SITE, absoluteUrl, canonicalUrl } from "@/lib/seo";
import { render } from "astro:content";

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);

  const paths = posts.map((post) => ({
    params: {
      single: post.id,
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const { title, meta_title, description, image, date, categories } = post.data;
const { Content } = await render(post);
const authors = postAuthors(post);

const allPosts = sortByDate(await getSinglePage("blog"));
const more = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const monthYear = (d: Date | undefined) =>
  d
    ? new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(
        new Date(d),
      )
    : "";

const postUrl = canonicalUrl(`/blog/${post.id}`);
const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${postUrl}#article`,
    headline: title,
    name: title,
    description,
    url: postUrl,
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    ...(date ? { datePublished: new Date(date).toISOString() } : {}),
    ...(date ? { dateModified: new Date(date).toISOString() } : {}),
    author: authors.map((name) => ({
      "@type": "Person",
      name,
      url: canonicalUrl(`/authors/${slugify(name)}`),
    })),
    publisher: { "@id": ORG_ID },
    image: absoluteUrl(image || SITE.image),
    inLanguage: SITE.lang,
    ...(post.data.tags?.length ? { keywords: post.data.tags.join(", ") } : {}),
    ...(categories?.length ? { articleSection: categories } : {}),
    isPartOf: {
      "@type": "Blog",
      "@id": `${canonicalUrl("/blog")}#blog`,
      name: `${SITE.name} — Blog`,
      publisher: { "@id": ORG_ID },
    },
  },
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  type="article"
  schema={schema}
  publishedTime={date}
  modifiedTime={date}
  articleAuthors={authors}
  articleTags={post.data.tags}
>
  <main>
    <section class="hero first">
      <div class="wrap">
        <div class="eyebrow">
          <span class="label">[ {categories?.[0] ?? "Blog"} ]</span>
          <span class="plus">++++</span>
        </div>
        <h1>{title}</h1>
        <p class="lede">
          {monthYear(date)}
          {
            authors.length > 0 && (
              <span class="byline-inline">
                {" · "}
                {authors.map((name, i) => (
                  <>
                    <a class="ulink" href={`/authors/${slugify(name)}`}>
                      {name}
                    </a>
                    {i !== authors.length - 1 && " & "}
                  </>
                ))}
              </span>
            )
          }
        </p>
      </div>
    </section>

    <section>
      <div class="wrap legal">
        <Content />
      </div>
    </section>

    {
      more.length > 0 && (
        <section>
          <div class="wrap">
            <div class="sechead">
              <span class="label">Keep reading</span>
              <h2>More posts.</h2>
            </div>
            {more.map((p) => (
              <a class="post" href={`/blog/${p.id}`}>
                <div
                  class="meta"
                  set:html={`${monthYear(p.data.date)}<br>${p.data.categories?.[0] ?? ""}`}
                />
                <div>
                  <h4>{p.data.title}</h4>
                  <p>{p.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section>
      <div class="wrap">
        <div class="cta">
          <span class="label">Next step</span>
          <h2>Reading is good. Doing is better.</h2>
          <p>
            If this post made you nod, book a call. We will do that thing for you
            this month.
          </p>
          <div class="btns">
            <a class="btn pri" href="/contact">Book a Free Call &rarr;</a>
            <a class="btn" href="/tools">Get the free guides &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
