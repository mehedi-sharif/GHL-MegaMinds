---
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { getHome } from '../data/site';

const { hero } = await getHome();
const c = hero.console;
---
<section id="top" class="relative overflow-hidden">
  <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(252,192,0,0.09),transparent)]" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pt-14 pb-20 sm:px-6 lg:grid-cols-[1.25fr_1fr] lg:gap-16 lg:px-8 lg:pt-24 lg:pb-24">
    <!-- Copy -->
    <div class="flex flex-col gap-7">
      <Eyebrow class="self-start">{hero.eyebrow}</Eyebrow>
      <h1 class="text-[52px] leading-none tracking-[-0.03em] sm:text-7xl lg:text-[64px] xl:text-[76px]">
        {hero.title}<br />
        <span class="text-brand italic">{hero.title_highlight}</span>
      </h1>
      <p class="max-w-[620px] text-lg leading-relaxed text-muted sm:text-[21px]">
        {hero.content}
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={hero.primary_button.link} size="lg" arrow>{hero.primary_button.label}</Button>
        <Button href={hero.secondary_button.link} size="lg" variant="outline">{hero.secondary_button.label}</Button>
      </div>

      <dl class="mt-2 grid grid-cols-1 gap-6 border-t border-hair pt-7 sm:grid-cols-3 sm:gap-0">
        {hero.stats.map((s, i) => (
          <div class:list={['flex flex-col gap-1.5', i > 0 && 'sm:border-l sm:border-hair sm:pl-6', i < 2 && 'sm:pr-6']}>
            <dt class="order-2 text-sm leading-snug text-muted">{s.text}</dt>
            <dd class="order-1 font-serif text-4xl tracking-tight sm:text-[44px] sm:leading-none">{s.stat}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Onboarding console illustration -->
    <div class="relative py-7 pl-4 sm:pl-7" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 -right-[50vw] rounded-l-[28px] bg-deep"></div>
      <div class="relative flex flex-col gap-5 rounded-[22px] border border-hair bg-card p-6 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)] sm:p-7">
        <div class="flex items-center justify-between gap-4">
          <div>
            <div class="text-xs font-semibold tracking-widest text-muted">{c.kicker}</div>
            <div class="mt-1 font-serif text-2xl tracking-tight sm:text-[27px]">{c.title}</div>
          </div>
          <div class="flex h-8 shrink-0 items-center gap-2 rounded-full bg-gold/15 px-3 text-[13px] font-semibold text-gold">
            <span class="size-[7px] rounded-full bg-gold"></span>{c.status}
          </div>
        </div>

        <ul class="flex flex-col">
          {c.checklist.map((s, i) => (
            <li class="flex items-center gap-3.5 border-b border-hair py-3">
              {s.done ? (
                <span class="tick-pop flex size-[26px] shrink-0 items-center justify-center rounded-full bg-green/15 text-green" style={`--i:${i}`}>
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                </span>
              ) : (
                <span class="size-[26px] shrink-0 rounded-full border-[1.5px] border-dashed border-muted"></span>
              )}
              <span class="grow text-[15px] font-medium sm:text-base">{s.label}</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-muted">{s.tag}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col gap-2.5">
          <div class="flex justify-between text-[13px] text-muted"><span>{c.progress_label}</span><span>{c.progress_target}</span></div>
          <div class="h-2 overflow-hidden rounded-full bg-hair"><div class="bar-fill h-2 rounded-full bg-brand" style={`width:${c.progress_percent}%`}></div></div>
        </div>

        <div class="flex items-center gap-2.5 rounded-xl bg-surface px-4 py-3.5 text-sm text-ink">
          <svg class="size-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z" /></svg>
          {c.note}
        </div>
      </div>
    </div>
  </div>
</section>
