---
import Eyebrow from './Eyebrow.astro';
import { getHome } from '../data/site';
import { hasPublicFile, initials } from '../lib/assets';
const { testimonial: t } = await getHome();
const hasPhoto = !!t.photo && hasPublicFile(t.photo);
---
<section id="testimonial" class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mb-8 max-w-3xl sm:mb-10">
      <Eyebrow class="mb-5">{t.eyebrow}</Eyebrow>
      <h2 class="text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-[54px]">
        {t.title} <span class="text-muted italic">{t.title_highlight}</span>
      </h2>
    </div>

    <figure data-reveal class="overflow-hidden rounded-[32px] border border-hair shadow-[0_20px_50px_rgba(0,0,0,0.35)]">
      <div class:list={['grid min-h-[260px]', hasPhoto && 'lg:grid-cols-[1.05fr_1.75fr]']}>
        {hasPhoto && (
          <div class="relative min-h-[320px] lg:min-h-full">
            <img src={t.photo} alt={t.alt} width="500" height="600" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/10 via-transparent to-transparent"></div>
          </div>
        )}

        <div class="relative flex items-center bg-card p-8 sm:p-10 lg:p-14">
          <div class="relative max-w-4xl">
            <div class="mb-5 font-serif text-7xl leading-none text-gold/70" aria-hidden="true">“</div>
            <blockquote class="font-serif text-[1.25rem] leading-[1.3] tracking-[-0.01em] sm:text-[1.5rem] lg:text-[1.9rem] lg:leading-[1.25]">
              {t.quote}
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              {!hasPhoto && (
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full border border-hair bg-surface font-serif text-lg">{initials(t.name)}</span>
              )}
              <div>
                <p class="text-lg font-semibold">{t.name}</p>
                <p class="text-muted">{t.role}</p>
              </div>
            </figcaption>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>
