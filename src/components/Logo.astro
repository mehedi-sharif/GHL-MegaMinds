---
interface Props { size?: 'sm' | 'md' }
const { size = 'md' } = Astro.props;
---
<span class="flex items-center gap-3">
  <span class:list={[
    'flex items-center justify-center rounded-[10px] bg-brand font-bold text-on-brand',
    size === 'md' ? 'size-9 text-[15px]' : 'size-8 text-sm',
  ]}>GM</span>
  <span class="font-serif text-2xl tracking-tight text-ink">GHL Megaminds</span>
</span>
