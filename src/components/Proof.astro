---
// Numbers are derived from site data so they stay accurate as projects/team change.
import { projects, team } from '../data/site';

const installs = projects.reduce((sum, p) => sum + (p.downloads ?? 0), 0);
const shipped = projects.filter((p) => !p.comingSoon).length;
const marketplaceApps = projects.filter((p) => p.downloads !== undefined).length;
const years = team.reduce((sum, m) => sum + parseInt(m.years), 0);
const certified = team.filter((m) => m.certified).length;

const stats = [
  { value: `${installs}`, label: 'installs of our GHL Marketplace apps' },
  { value: `${marketplaceApps}`, label: 'custom apps live on the Marketplace' },
  { value: `${shipped}`, label: 'products shipped for HighLevel agencies' },
  { value: `${years}+ yrs`, label: `combined engineering experience, ${certified} certified admins` },
];
---
<section aria-label="Track record" class="border-y border-hair">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <dl data-reveal-stagger class="grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class:list={[
          'flex flex-col gap-2 py-8 sm:py-10',
          i % 2 === 1 && 'border-l border-hair pl-5 sm:pl-8',
          i >= 2 && 'border-t border-hair lg:border-t-0',
          i === 2 && 'lg:border-l lg:pl-8',
          i > 0 && 'lg:pl-8',
        ]}>
          <dt class="order-2 max-w-[220px] text-sm leading-snug text-muted">{s.label}</dt>
          <dd class="order-1 font-serif text-4xl tracking-tight sm:text-5xl">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
