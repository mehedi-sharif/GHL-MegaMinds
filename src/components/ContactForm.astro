---
// Native contact form that posts JSON to a GoHighLevel Inbound Webhook.
// The GHL workflow triggered by the webhook maps these keys to contact fields.
import Button from './Button.astro';
import { BOOKING_URL } from '../data/site';

interface Props { webhookUrl: string }
const { webhookUrl } = Astro.props;

const subAccountOptions = ['1 - 20', '20 - 50', '50 - 100', '100+'];
const field = 'h-12 w-full rounded-xl border border-hair bg-surface px-4 text-[15px] text-ink placeholder:text-dim transition outline-none focus:border-gold/60 focus:ring-2 focus:ring-gold/20';
const label = 'mb-2 block text-sm font-medium text-ink/90';
---
<div class="rounded-[20px] bg-surface/40 p-5 sm:p-7">
  <form id="contact-form" data-webhook={webhookUrl} class="relative flex flex-col gap-5" novalidate>
    <div>
      <h2 class="text-3xl tracking-tight">Tell us about your agency</h2>
      <p class="mt-2 text-[15px] text-muted">A few quick details and we'll come back with next steps.</p>
    </div>

    <div>
      <label for="cf-name" class={label}>Full name</label>
      <input id="cf-name" name="full_name" type="text" autocomplete="name" placeholder="Enter your full name" class={field} />
    </div>

    <div>
      <label for="cf-email" class={label}>Email <span class="text-gold">*</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@agency.com" class={field} />
    </div>

    <div>
      <label for="cf-website" class={label}>Website <span class="text-gold">*</span></label>
      <input id="cf-website" name="website" type="text" inputmode="url" autocomplete="url" required placeholder="youragency.com" class={field} />
    </div>

    <div>
      <label for="cf-subs" class={label}>How many active client sub-accounts do you currently manage? <span class="text-gold">*</span></label>
      <div class="relative">
        <select id="cf-subs" name="sub_accounts" required class:list={[field, 'appearance-none pr-10 invalid:text-dim']}>
          <option value="" disabled selected>Select sub-account count</option>
          {subAccountOptions.map((o) => <option value={o} class="text-ink">{o}</option>)}
        </select>
        <svg class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </div>
    </div>

    <!-- Honeypot: hidden from people, bots tend to fill it -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="cf-company-fax">Company fax</label>
      <input id="cf-company-fax" name="company_fax" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p id="cf-error" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert"></p>

    <button type="submit" class="bg-brand inline-flex h-13 items-center justify-center gap-2 rounded-full text-base font-semibold text-on-brand transition hover:brightness-110 disabled:cursor-wait disabled:opacity-70">
      <span data-label>Send message</span>
      <svg data-spinner class="hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.3" /><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </button>
    <p class="text-center text-xs text-dim">By submitting, you agree to be contacted about your enquiry.</p>
  </form>

  <!-- Success state -->
  <div id="cf-success" class="hidden flex-col items-center gap-5 py-12 text-center" role="status" tabindex="-1">
    <span class="flex size-14 items-center justify-center rounded-full bg-green/15 text-green ring-1 ring-green/30">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    </span>
    <h2 class="text-3xl tracking-tight">Thanks, we've got it.</h2>
    <p class="max-w-sm leading-relaxed text-muted">We'll be in touch shortly. Want to skip the back-and-forth? Grab a time on our calendar.</p>
    <Button href={BOOKING_URL} arrow>Book a discovery call</Button>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('cf-success');
  const errorBox = document.getElementById('cf-error');

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  };

  const normaliseUrl = (v: string) => (v && !/^https?:\/\//i.test(v) ? `https://${v}` : v);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const done = () => {
      form.classList.add('hidden');
      success?.classList.replace('hidden', 'flex');
      success?.focus();
    };

    // Bot filled the honeypot: pretend it worked, send nothing.
    if (data.company_fax) return done();

    const fullName = (data.full_name || '').trim();
    const [firstName, ...rest] = fullName.split(/\s+/);
    const params = new URLSearchParams(location.search);
    const payload = {
      full_name: fullName,
      first_name: firstName || '',
      last_name: rest.join(' '),
      email: data.email.trim(),
      website: normaliseUrl(data.website.trim()),
      sub_accounts: data.sub_accounts,
      source: 'Website contact form',
      page_url: location.href,
      utm_source: params.get('utm_source') || '',
      utm_medium: params.get('utm_medium') || '',
      utm_campaign: params.get('utm_campaign') || '',
    };

    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    button.disabled = true;
    button.querySelector('[data-spinner]')?.classList.remove('hidden');
    button.querySelector('[data-label]')!.textContent = 'Sending…';

    try {
      const res = await fetch(form.dataset.webhook!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      (window as any).dataLayer?.push({ event: 'contact_form_submit', form_name: 'contact', sub_accounts: payload.sub_accounts });
      done();
    } catch {
      showError("Sorry, something went wrong sending your message. Please try again, or book a call directly.");
      button.disabled = false;
      button.querySelector('[data-spinner]')?.classList.add('hidden');
      button.querySelector('[data-label]')!.textContent = 'Send message';
    }
  });
</script>
