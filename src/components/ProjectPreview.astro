---
// Decorative mini-UI illustration shown at the top of each project card.
import type { ProjectPreview } from '../data/site';
interface Props { kind: ProjectPreview; class?: string }
const { kind, class: className = '' } = Astro.props;

const backgrounds: Record<ProjectPreview, string> = {
  middleware: 'bg-[radial-gradient(circle_at_top,#2c2a3b_0%,#111827_38%,#090b12_100%)]',
  pricing: 'bg-[radial-gradient(circle_at_top,#071a2e_0%,#0c1d2f_30%,#050b11_100%)]',
  llms: 'bg-[radial-gradient(circle_at_top,#0c3d49_0%,#051d2f_35%,#07141d_100%)]',
  telegram: 'bg-[radial-gradient(circle_at_top,#07171e_0%,#0d1b24_32%,#050a10_100%)]',
  payments: 'bg-[radial-gradient(circle_at_top,#1a1d2c_0%,#090b14_42%,#05070c_100%)]',
  astro: 'bg-[radial-gradient(circle_at_top,#090b13_0%,#120a2d_25%,#05070b_100%)]',
  portal: 'bg-[radial-gradient(circle_at_top,#0f172a_0%,#111827_32%,#050b12_100%)]',
};
const bar = 'rounded-full bg-white/15';
---
<div class:list={['relative h-56 overflow-hidden px-5 pt-9 pb-5', backgrounds[kind], className]} aria-hidden="true">
  <div class="h-40 rounded-2xl border border-white/10 bg-[#111827]/75 p-3">
    {kind === 'middleware' && (
      <div class="flex h-full items-center px-2">
        <div class="flex flex-col items-center gap-3"><div class="size-10 rounded-xl border border-white/15 bg-white/5"></div><div class={`h-2.5 w-12 ${bar}`}></div></div>
        <div class="mx-3 h-px grow bg-gold/50"></div>
        <div class="flex h-14 w-20 shrink-0 items-center justify-center rounded-2xl border border-gold/40 bg-[#151d2e] shadow-[0_0_24px_rgba(252,192,0,0.15)]">
          <div class="flex size-7 items-center justify-center rounded-lg bg-gold/20 ring-1 ring-gold/50"><div class="size-2.5 rounded-full bg-gold"></div></div>
        </div>
        <div class="mx-3 h-px grow bg-gold/50"></div>
        <div class="flex flex-col items-center gap-3"><div class="size-10 rounded-xl border border-white/15 bg-white/5"></div><div class={`h-2.5 w-12 ${bar}`}></div></div>
      </div>
    )}

    {kind === 'pricing' && (
      <div class="flex h-full flex-col gap-2 rounded-xl bg-[linear-gradient(180deg,#091827,#0b1d2e)] p-2.5">
        <div class="flex justify-between"><div class="h-2.5 w-14 rounded-full bg-white/20"></div><div class="h-2.5 w-9 rounded-full bg-gold/70"></div></div>
        {[['w-16', 'bg-[#6FA8FF]/25'], ['w-20', 'bg-gold/25'], ['w-14', 'bg-[#6FA8FF]/25']].map(([w, pill]) => (
          <div class="flex items-center rounded-md border border-white/5 bg-white/[0.03] p-2">
            <div class={`h-2.5 ${w} ${bar}`}></div><div class={`ml-auto h-4 w-10 rounded-full ${pill}`}></div>
          </div>
        ))}
      </div>
    )}

    {kind === 'llms' && (
      <div class="flex h-full rounded-xl border border-white/10 bg-[linear-gradient(180deg,#0f1d2f,#0b1422)] p-2">
        <div class="flex grow flex-col gap-2 rounded-[10px] border border-white/10 bg-white/[0.03] p-2">
          <div class="flex items-center gap-2"><div class="size-2.5 rounded-full bg-gold"></div><div class="h-2 w-16 rounded-full bg-white/20"></div></div>
          {['w-16', 'w-10', 'w-14'].map((w) => (
            <div class="flex items-center gap-2"><div class="size-1.5 rounded-full bg-gold"></div><div class={`h-1.5 ${w} ${bar}`}></div><div class="h-1.5 grow rounded-full bg-white/10"></div></div>
          ))}
        </div>
        <div class="ml-2 flex w-14 items-center justify-center">
          <div class="flex size-8 items-center justify-center rounded-full border border-gold/60 bg-gold/20 shadow-[0_0_14px_rgba(252,192,0,0.35)]"><div class="size-3 rounded-full bg-gold"></div></div>
        </div>
      </div>
    )}

    {kind === 'telegram' && (
      <div class="flex h-full gap-2">
        <div class="flex w-1/3 flex-col gap-2 rounded-xl border border-white/10 bg-white/5 p-2">
          <div class={`mb-1 h-2.5 w-10 ${bar}`}></div><div class="h-3 rounded-full bg-white/10"></div><div class="h-3 w-2/3 rounded-full bg-white/10"></div>
        </div>
        <div class="flex grow flex-col gap-2 rounded-xl border border-white/10 bg-[linear-gradient(135deg,#101d2e,#0c1218)] p-2">
          <div class="mb-1 flex justify-between"><div class="h-2.5 w-12 rounded-full bg-white/20"></div><div class="size-2.5 rounded-full bg-gold"></div></div>
          <div class="h-6 w-3/5 self-end rounded-full bg-gold/25"></div>
          <div class="h-6 w-2/3 rounded-full bg-white/10"></div>
          <div class="h-6 w-2/5 self-end rounded-full bg-gold/25"></div>
        </div>
      </div>
    )}

    {kind === 'payments' && (
      <div class="flex h-full flex-col gap-3">
        <div class="flex flex-col gap-3 rounded-[14px] border border-gold/30 bg-[linear-gradient(135deg,#1f2d3d,#0f172a)] p-3">
          <div class="flex items-center justify-between"><div class="flex items-center gap-2"><div class="size-2.5 rounded-full bg-gold"></div><div class="h-2.5 w-8 rounded-full bg-white/20"></div></div><div class={`h-2.5 w-7 ${bar}`}></div></div>
          <div class="flex items-end gap-2">
            <div class="flex size-9 items-center justify-center rounded-full bg-gold/20 text-lg font-bold text-[#FFE8A3] ring-1 ring-gold/50">৳</div>
            <div class="flex flex-col gap-2"><div class={`h-2.5 w-16 ${bar}`}></div><div class="h-3.5 w-20 rounded-full bg-white/20"></div></div>
          </div>
        </div>
        <div class="flex items-center justify-between"><div class={`h-2 w-16 ${bar}`}></div><div class="flex gap-1.5"><span class="size-2.5 rounded-full bg-white/20"></span><span class="size-2.5 rounded-full bg-white/20"></span><span class="size-2.5 rounded-full bg-gold/70"></span></div></div>
      </div>
    )}

    {kind === 'astro' && (
      <div class="flex h-full flex-col justify-center rounded-xl border border-white/10 bg-[linear-gradient(180deg,#111827,#0b1020)] p-3">
        <div class="flex flex-col gap-2 rounded-[10px] border border-white/10 bg-[linear-gradient(135deg,#1e293b,#0f172a)] p-2">
          <div class={`h-3 w-12 ${bar}`}></div>
          <div class="grid grid-cols-3 gap-2"><div class="h-11 rounded-md bg-white/5"></div><div class="h-11 rounded-md bg-gold/20"></div><div class="h-11 rounded-md bg-white/5"></div></div>
          <div class="h-2.5 w-24 rounded-full bg-white/20"></div>
        </div>
      </div>
    )}

    {kind === 'portal' && (
      <div class="flex h-full flex-col justify-center gap-3 px-1">
        <div class="flex justify-between"><div class="h-2.5 w-20 rounded-full bg-white/20"></div><div class="h-2.5 w-9 rounded-full bg-gold/80"></div></div>
        <div class="grid grid-cols-3 gap-2"><div class="h-10 rounded-lg border border-white/10 bg-white/5"></div><div class="h-10 rounded-lg border border-white/10 bg-white/5"></div><div class="h-10 rounded-lg border border-white/10 bg-white/5"></div></div>
        <div class="flex items-center gap-2"><div class={`h-2.5 w-10 ${bar}`}></div><div class="h-2.5 grow rounded-full bg-gold/50"></div></div>
      </div>
    )}
  </div>
</div>
