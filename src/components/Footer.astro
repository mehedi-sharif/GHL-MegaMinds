---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { BOOKING_URL, trust } from '../data/site';

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Client Onboarding & Setup', href: '/#offers' },
      { label: 'Ongoing Tech Support', href: '/#offers' },
      { label: 'Custom App & Wrapper Dev', href: '/#offers' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Why us', href: '/#why-us' },
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Projects', href: '/#projects' },
      { label: 'Team', href: '/#team' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden border-t border-hair bg-surface">
  <div class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8 lg:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <div class="flex flex-col items-start gap-5">
        <Logo />
        <p class="max-w-sm text-[15px] leading-relaxed text-muted">
          White-label HighLevel support by certified admins and software engineers.
        </p>
        <Button href={BOOKING_URL} arrow class="mt-1">Book a discovery call</Button>
        <ul class="flex flex-col gap-2 text-sm text-muted">
          {trust.map((t) => (
            <li class="flex items-center gap-2">
              <svg class="size-3.5 text-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title} class="flex flex-col gap-3.5 text-[15px]">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">{col.title}</p>
          {col.links.map((l) => <a href={l.href} class="self-start text-ink/85 transition hover:text-ink">{l.label}</a>)}
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-col-reverse items-start justify-between gap-4 border-t border-hair py-6 text-[13px] text-muted sm:flex-row sm:items-center">
      <p>© {year} GHL Megaminds. All rights reserved.</p>
      <a href="#" class="inline-flex items-center gap-1.5 transition hover:text-ink">
        Back to top
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
      </a>
    </div>
  </div>

  <!-- Oversized wordmark -->
  <p class="pointer-events-none -mb-[0.22em] select-none text-center font-serif text-[18vw] leading-none tracking-[-0.04em] text-white/[0.035] lg:text-[15vw]" aria-hidden="true">
    Megaminds
  </p>
</footer>
